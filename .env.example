SECRET_KEY=change-this-later

DB_NAME=landlordpms
DB_USER=landlordpms
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Production only (config/settings/prod.py)
# ALLOWED_HOSTS=app.nyumbapms.com
# SITE_URL=https://app.nyumbapms.com
# REDIS_URL=redis://localhost:6379/0
# EMAIL_HOST=smtp.example.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=NyumbaPMS <no-reply@nyumbapms.com>
# Optional second provider for mail to tenants and owners (receipts, statements, invitations). The EMAIL_*
# provider above keeps sign-in codes, alerts and support mail. Leave these out to use one provider for all.
# EMAIL_MESSAGES_HOST=smtp-relay.brevo.com
# EMAIL_MESSAGES_PORT=587
# EMAIL_MESSAGES_USER=
# EMAIL_MESSAGES_PASSWORD=
# TRUSTED_PROXY_COUNT=1
# Provider keys (SMS, WhatsApp, OpenAI, Paybill, Paystack, push, contacts) can instead be typed into Django admin >
# Platform settings (D-207). A value saved there beats this file; this file is the fallback.
# SMS_BACKEND=notifications.providers.sms.AfricasTalkingSmsSender
# AT_USERNAME=sandbox
# AT_API_KEY=
# AT_SENDER_ID=
# Celcom Africa instead: SMS_BACKEND=notifications.providers.sms.CelcomSmsSender
# CELCOM_API_KEY=
# CELCOM_PARTNER_ID=
# CELCOM_SENDER_ID=
# AT_CALLBACK_TOKEN=    # 32+ random chars, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
# ALLOW_CONSOLE_SMS=1   # staging only, without an SMS account

# Encrypts Daraja keys at rest; required in production. Generate with
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FIELD_ENCRYPTION_KEYS=
# MPESA_ALLOWED_IPS=    # set these two in production, comma-separated Safaricom callback IPs
# Paystack, for the subscription payments to us only (D-126, D-140)
# PAYSTACK_ALLOWED_IPS=    # set in production, comma-separated Paystack webhook IPs
# PAYSTACK_EMAIL_DOMAIN=   # defaults to SITE_URL's host

# Landlords paying their NyumbaPMS subscription to us (D-126). Set either or both; each can be switched
# off in Django admin (Subscriptions > Online payment switch). Check with: manage.py platform_payments
# PLATFORM_PAYBILL=                 # our Paybill, shown on the subscription page and invoices
# PLATFORM_CALLBACK_TOKEN=          # 32+ random chars; the secret part of /hooks/plat/<token>/...
# Our Paybill through Daraja (M-Pesa prompt + Paybill by hand); then run: manage.py platform_payments --register
# PLATFORM_DARAJA_ENVIRONMENT=SANDBOX   # PRODUCTION when live
# PLATFORM_DARAJA_SHORTCODE=        # defaults to PLATFORM_PAYBILL
# PLATFORM_DARAJA_CONSUMER_KEY=
# PLATFORM_DARAJA_CONSUMER_SECRET=
# PLATFORM_DARAJA_PASSKEY=          # needed for the prompt
# Our Paystack account (card or M-Pesa on Paystack's page); webhook URL: <SITE_URL>/hooks/plat/<token>/ps/
# PLATFORM_PAYSTACK_SECRET_KEY=     # sk_test_... or sk_live_...

# Login lengths and the Content Security Policy (D-107); these are the defaults
# SESSION_IDLE_MINUTES=60
# SESSION_MAX_HOURS=12
# PORTAL_SESSION_IDLE_DAYS=14
# PORTAL_SESSION_MAX_DAYS=30
# "Remember me" at login uses these longer limits instead
# SESSION_REMEMBER_IDLE_MINUTES=480
# SESSION_REMEMBER_MAX_HOURS=168
# PORTAL_REMEMBER_IDLE_DAYS=60
# PORTAL_REMEMBER_MAX_DAYS=180
# CSP_REPORT_ONLY=1     # report what the policy would block without blocking it

# Texts for the same alerts, and what trips them (0 turns a check off)
# OPS_ALERT_PHONES=254700000000
# ALERT_FAILED_MESSAGES=20
# ALERT_UNMATCHED_DAYS=2
# ALERT_SUPPORT_HOURS=24

# Attack alerts to OPS_ALERT_EMAILS (D-108): more than this many in an hour, across the platform; the defaults
# SECURITY_ALERT_SIGNIN_HOUR=300
# SECURITY_ALERT_TWO_STEP_HOUR=100
# SECURITY_ALERT_CSP_HOUR=500

# The assistant (D-091, D-115): no key means it is not offered; owners still switch it on per organization
# OPENAI_API_KEY=
# ASSISTANT_MODEL=gpt-5.6-terra
# Photos of meter notebooks and utility bills read on the same key (D-144): scans a month per organization
# SCAN_MODEL=gpt-5.6-terra
# SCAN_MONTHLY_LIMIT=100
# What the model costs us (USD per million tokens) and the exchange rate, for the usage pages
# AI_PRICE_INPUT_PER_M=2.00
# AI_PRICE_OUTPUT_PER_M=12.00
# USD_TO_KES=129

# Messages a month your plans allow (D-138). The console shows how close each channel is. Blank: not shown.
EMAIL_MONTHLY_LIMIT=
SMS_MONTHLY_LIMIT=
WHATSAPP_MONTHLY_LIMIT=

# Error tracking: Sentry project DSN (sentry.io, EU region). No personal data is sent (D-097)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# Product analytics: PostHog project key (eu.posthog.com), server-side events only (D-140)
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://eu.i.posthog.com
# Dashboard links for the console Tools page
# SENTRY_DASHBOARD_URL=https://sentry.io/organizations/<org>/issues/
# POSTHOG_DASHBOARD_URL=https://eu.posthog.com/
# GOOGLE_ANALYTICS_URL=https://analytics.google.com/

# Local speed on Windows: reuse database connections (a fresh one costs 100-150 ms per request under runserver).
DB_POOL=1
